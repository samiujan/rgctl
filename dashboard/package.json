{
  "name": "rgctl-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/migration src/MutationsPanel.test.ts",
    "test:mutations": "node scripts/test-mutations-panel.mjs",
    "build:v2": "vite build --config vite.config.v2.ts",
    "dev:v2": "vite --config vite.config.v2.ts",
    "typecheck:v2": "tsc -p tsconfig.v2.json --noEmit",
    "build:all": "npm run build && npm run build:v2"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "codemirror": "^6.0.2",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "preact": "^10.25.4",
    "sigma": "^3.0.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.170.44",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "playwright": "^1.61.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0"
  }
}
