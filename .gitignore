mock/node_modules/
mock/dist/
mock/*.tsbuildinfo

# ...but keep its dataset. Line 54 above ignores `graph.json` by basename to keep
# generated repo graphs out of the tree; mock/src/data/graph.json is neither
# generated nor a repo graph — it is hand-built, anonymized fixture source, and
# the mock does not build without it.
!mock/src/data/graph.json
